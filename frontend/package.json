{
  "name": "mmbroilers-frontend",
  "main": "expo/AppEntry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "start:dev": "expo start --dev-client",
    "android": "expo start --android",
    "web": "expo start --web",
    "lint": "eslint App.tsx src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "prebuild:android": "expo prebuild --platform android",
    "build:debug-apk": "bash ./scripts/build-debug-apk.sh",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@haroldtran/react-native-thermal-printer": "^1.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.14.12",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.15.2",
    "expo": "^57.0.0",
    "expo-dev-client": "~57.0.10",
    "expo-file-system": "~57.0.2",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-ble-plx": "^3.5.1",
    "react-native-css-interop": "^0.2.6",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@haroldtran/react-native-thermal-printer",
          "react-native-ping"
        ],
        "listUnknownPackages": false
      }
    },
    "install": {
      "exclude": [
        "@haroldtran/react-native-thermal-printer"
      ]
    }
  },
  "private": true
}
