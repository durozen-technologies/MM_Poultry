POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=MM_Poultry

SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
# Minimum 32 chars; generate: openssl rand -hex 32
BACKUP_SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

PRODUCTION=false
# Comma-separated origins; set explicitly in production (e.g. https://app.example.com)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1
APP_NAME=Broiler Wholesale API
API_V1_PREFIX=/api/v1
